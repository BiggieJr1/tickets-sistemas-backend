# Copia este archivo como .env junto a docker-compose.yml y llena los
# valores reales. El .env nunca se sube a git (ver .gitignore).

# Contraseña del Postgres local (contenedor tickets-db). Elige una nueva y
# fuerte; no se reutiliza la de Supabase.
DB_PASSWORD=

# Puerto del host donde se expone ese Postgres (solo en 127.0.0.1). Déjalo
# vacío para usar 5432; cámbialo (ej. 5433) si ya hay otro Postgres
# instalado en la máquina.
DB_HOST_PORT=

# Administradores iniciales, separados por comas si son varios. Solo se
# crean los que todavía no existan como Colaborador.
SEED_ADMIN_EMAIL=

# Credenciales de Microsoft Graph (Mail.Send, User.Read.All). Railway ya se
# dio de baja, así que el secreto sale de tu gestor de secretos o, si no lo
# guardaste, genera uno nuevo en Azure: App registrations →
# tickets-sistemas-api → Certificates & secrets (y borra el anterior). No lo
# pegues en chats ni documentos.
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=
