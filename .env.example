# Copia este archivo como .env junto a docker-compose.yml y llena los
# valores reales. El .env nunca se sube a git (ver .gitignore).

# Contraseña del Postgres local (contenedor tickets-db). Elige una nueva y
# fuerte; no se reutiliza la de Supabase.
DB_PASSWORD=

# Primer administrador (solo se usa si la base está vacía).
SEED_ADMIN_EMAIL=

# Credenciales de Microsoft Graph (Mail.Send, User.Read.All). El secreto es
# el mismo que ya está configurado en Railway: cópialo desde ahí o desde el
# App Registration, no lo pegues en chats ni documentos.
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=
